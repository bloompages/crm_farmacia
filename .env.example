# Postgres de desenvolvimento (use um schema só seu, separado da produção)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=dev&sslmode=require"
# Schema exclusivo dos testes — apagado e recriado a cada `npm run test`
DATABASE_URL_TESTE="postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=teste&sslmode=require"

# ---- Provedor de mensageria ----
# mock  -> simulador local (padrao)
# meta  -> WhatsApp Cloud API + Instagram Messaging (Meta Graph API)
PROVEDOR_MENSAGERIA="mock"

# Preencha ao migrar para "meta":
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_TOKEN=""
META_VERIFY_TOKEN="crm-farmacia-verify"
# Com o app secret preenchido o CRM valida a assinatura X-Hub-Signature-256 de cada webhook.
META_APP_SECRET=""
# Nome do template aprovado na Meta usado para reabrir conversas após 24h sem resposta do cliente.
WHATSAPP_TEMPLATE_REABERTURA=""
