# Postgres de desenvolvimento (use um schema só seu, separado da produção)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=dev&sslmode=require"
# Schema exclusivo dos testes — apagado e recriado a cada `npm run test`
DATABASE_URL_TESTE="postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=teste&sslmode=require"

# ---- Segredos da instalação (definidos pelo fornecedor ao criar a instância) ----
# Chave que cifra os tokens do WhatsApp/Instagram guardados no banco. Uma diferente por
# farmácia; gere com: openssl rand -base64 32. Trocar a chave obriga a recadastrar os tokens.
CHAVE_CRIPTOGRAFIA=""
# App secret do app da Meta que recebe os webhooks desta farmácia. Valida a assinatura
# X-Hub-Signature-256 de cada webhook; em produção, sem ele os webhooks são recusados.
META_APP_SECRET=""

# ---- Simulador ----
# Sem esta variável, o CRM usa a Meta assim que o WhatsApp/Instagram for conectado pela tela.
# "mock" força o simulador local (npm run simular); não defina em produção.
PROVEDOR_MENSAGERIA="mock"

# ---- Legado (opcional) ----
# A farmácia agora preenche WhatsApp, Instagram, template e dados da política de privacidade em
# Configurações › Farmácia e integrações. As variáveis abaixo só valem quando o campo
# correspondente da tela está vazio.
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TOKEN=""
# WHATSAPP_TEMPLATE_REABERTURA=""
# INSTAGRAM_ACCOUNT_ID=""
# INSTAGRAM_TOKEN=""
# META_VERIFY_TOKEN=""          # a tela gera um token de verificação próprio; este é aceito também
# PRIVACIDADE_CONTROLADOR="" PRIVACIDADE_CNPJ="" PRIVACIDADE_ENDERECO="" PRIVACIDADE_EMAIL="" PRIVACIDADE_TELEFONE=""
